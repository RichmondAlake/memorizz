# MemoRizz environment template
# Copy to .env, fill only the providers you use, and never commit real secrets.
# Or use: memorizz config set KEY [VALUE] (--project to edit this file).
# Omit credentials from command arguments: memorizz config set NOTION_TOKEN
# Guided memory setup: memorizz memory configure / memorizz notion connect
# Precedence: process exports > project .env > ~/.memorizz/.env (or override).
# Even an empty project assignment shadows a saved value: remove unused blank
# entries when using shared defaults. Restart existing processes after saving.

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# MEMORIZZ_DEFAULT_LLM_PROVIDER=openai
# MEMORIZZ_DEFAULT_LLM_MODEL=gpt-4.1-mini

# Internet access
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# MEMORIZZ_DEFAULT_INTERNET_PROVIDER=tavily

# Stateful code sandbox
E2B_API_KEY=
# MEMORIZZ_DEFAULT_SANDBOX_PROVIDER=e2b
# MEMORIZZ_GRAALPY_MODE=subprocess
# MEMORIZZ_GRAALPY_INTERNET_ACCESS=false
# GRAALPY_PATH=/absolute/path/to/graalpy
# GRAALPY_JAVA_WRAPPER_JAR=/absolute/path/to/validated-wrapper.jar

# Governed browser control (explicit opt-in)
# Install Browser Use in an isolated Python 3.11+ tool environment first.
# MEMORIZZ_BROWSER_CONTROL_PROVIDER=browseruse
# MEMORIZZ_BROWSER_USE_COMMAND=browser-use
# MEMORIZZ_BROWSER_USE_PYTHON_COMMAND=/absolute/path/to/browser-use/bin/python
# MEMORIZZ_BROWSER_USE_LLM_PROVIDER=openai
# MEMORIZZ_BROWSER_USE_MODEL=gpt-4.1-mini
# MEMORIZZ_BROWSER_USE_HEADLESS=true
# MEMORIZZ_BROWSER_USE_VISION=true
# MEMORIZZ_BROWSER_USE_ALLOWED_DOMAINS=example.com,*.notion.so
# MEMORIZZ_BROWSER_USE_PROHIBITED_DOMAINS=
# MEMORIZZ_BROWSER_USE_BLOCK_IP_ADDRESSES=true
# MEMORIZZ_BROWSER_USE_MAX_STEPS=25
# MEMORIZZ_BROWSER_USE_TASK_TIMEOUT=600
BROWSER_USE_API_KEY=
GOOGLE_API_KEY=

# Oracle AI Database. Generate unique admin and application passwords; the
# package intentionally has no password defaults.
# MEMORIZZ_BACKEND=oracle
ORACLE_ADMIN_USER=system
ORACLE_ADMIN_PASSWORD=
ORACLE_USER=memorizz_user
ORACLE_PASSWORD=
ORACLE_DSN=localhost:1521/FREEPDB1
# ORACLE_SCHEMA=MEMORIZZ_USER
# MEMORIZZ_ORACLE_CONTAINER=oracle-memorizz
# MEMORIZZ_ORACLE_INDEX_POLICY=lazy
# MEMORIZZ_ORACLE_IN_DATABASE_EMBEDDING=true
# ORACLE_EMBEDDING_MODEL=ALL_MINILM_L12_V2
# ORACLE_EMBEDDING_DIM=384

# External embeddings (filesystem, MongoDB, Notion vectors, or external Oracle)
# MEMORIZZ_DEFAULT_EMBEDDING_PROVIDER=openai
# MEMORIZZ_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
# MEMORIZZ_DEFAULT_EMBEDDING_DIMENSIONS=1536

# Notion document memory with a separate semantic provider (explicit opt-in).
# Guided: memorizz notion connect (accepts an existing database or shared parent).
# Scripted provisioning only: memorizz notion init --parent-page-id SHARED_PAGE_ID
# Select the backend once; do not also enable the Oracle line above.
# MEMORIZZ_BACKEND=notion
# NOTION_TOKEN=
# MEMORIZZ_NOTION_DATA_SOURCE_ID=
# MEMORIZZ_NOTION_SEMANTIC_BACKEND=filesystem
# MEMORIZZ_NOTION_VECTOR_PATH=/absolute/path/to/notion-vectors
# MEMORIZZ_NOTION_STATE_PATH=/absolute/path/to/notion-repair.sqlite3
# MEMORIZZ_NOTION_MONGODB_URI=
# MEMORIZZ_NOTION_VECTOR_DB=memorizz_notion_vectors
# Optional live-test parent; never point at an unapproved/shared production area.
# MEMORIZZ_NOTION_TEST_PARENT_PAGE_ID=

# MCP client credential encryption and first-party MCP server
# MEMORIZZ_MCP_ENCRYPTION_KEY=<Fernet key from your secret manager>
# MEMORIZZ_MCP_SERVER_API_KEYS={"operator":{"token":"<secret>","scopes":["memorizz:read"]}}
# MEMORIZZ_MCP_SERVER_HOST=127.0.0.1
# MEMORIZZ_MCP_SERVER_PORT=8766

# Skills marketplace
SKILLSMP_API_KEY=
GITHUB_TOKEN=
