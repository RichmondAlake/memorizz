{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memorizz",
  "version": "0.1.0",
  "identifier": "com.memorizz.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:8765",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Memorizz",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Memory-augmented AI agents, locally.",
    "longDescription": "Memorizz desktop wraps the local Memorizz UI (http://127.0.0.1:8765) for a double-click experience on macOS."
  }
}
