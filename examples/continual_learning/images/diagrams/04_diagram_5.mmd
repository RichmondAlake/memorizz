    G1 -->|yes| G2{"A file to attach<br/>over 25MB?"}
    G2 -->|yes| X2["Refused: BCN-217"]
    G2 -->|no| OK["The tool runs"]
    REC --> G3{"Policy number<br/>has its K-?"}
